{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence pack (agent answer, and part of the case detail)",
  "type": "object",
  "required": ["text", "grounding_ok", "ungrounded_items", "source"],
  "additionalProperties": false,
  "properties": {
    "text": {"type": "string", "minLength": 1},
    "grounding_ok": {"type": "boolean"},
    "ungrounded_items": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "string", "description": "\"template\", or the model name"}
  }
}
