{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghosttrace.local/schemas/vision-match.schema.json",
  "title": "AI vision reading of labelled simulated camera frames",
  "description": "Simulated data. The model reads every frame into a fingerprint. Code compares the fingerprints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["frames", "notes"],
  "properties": {
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "body", "colour", "plate", "marks"],
        "properties": {
          "label": {"type": "string", "maxLength": 20},
          "body": {"type": "string", "maxLength": 80},
          "colour": {"type": "string", "maxLength": 80},
          "plate": {"type": "string", "maxLength": 80},
          "marks": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "colour", "side"],
              "properties": {
                "kind": {"enum": ["sticker", "dent", "roof_rack", "spare_wheel", "stripe", "bumper_guard", "tow_hook", "other"]},
                "colour": {"type": ["string", "null"], "maxLength": 40},
                "side": {"enum": ["left", "right", "centre", null]}
              }
            }
          }
        }
      }
    },
    "notes": {"type": "string", "maxLength": 800}
  }
}
